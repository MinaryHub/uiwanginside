# 의왕 인사이드 환경변수 예시
# 이 파일을 .env.local 로 복사한 뒤 필요한 키만 채워 넣으세요.
# 키가 비어 있는 항목은 가짜 데이터 대신 "미연동" 안내 또는 공개 대체 소스(OSM)로 표시됩니다.

# ── 지도 & 장소 ────────────────────────────────────────────────
# 카카오 개발자 콘솔 (https://developers.kakao.com)
# JavaScript 키: 없으면 Leaflet + OpenStreetMap 지도로 자동 대체
NEXT_PUBLIC_KAKAO_JS_KEY=
# (선택) 대체 지도 타일 URL 템플릿 (기본: OpenStreetMap)
NEXT_PUBLIC_MAP_TILES=
# REST API 키: 장소 검색·지오코딩 (없으면 OSM Overpass 로 폴백)
KAKAO_REST_KEY=

# ── 공공데이터포털 (https://www.data.go.kr) ─────────────────────
# Decoding / Encoding 키 모두 자동 정규화되어 동작합니다.
# 기상청 단기예보·초단기실황·기상특보 (다른 data.go.kr 키의 기본 폴백으로도 사용)
KMA_SERVICE_KEY=
# 에어코리아 대기오염정보 (비우면 KMA_SERVICE_KEY 재사용)
AIRKOREA_SERVICE_KEY=
# 국립중앙의료원 병·의원/약국/응급실 (비우면 KMA_SERVICE_KEY 재사용)
EMERGENCY_SERVICE_KEY=
# 경기도 의왕시_공장 현황 ODCloud API (15126591, 비우면 KMA_SERVICE_KEY 재사용)
FACTORY_SERVICE_KEY=
# 한국환경공단 전기자동차 충전소 정보 (B552584, 비우면 KMA_SERVICE_KEY 재사용)
EV_CHARGER_SERVICE_KEY=
# 행정안전부 무더위쉼터 정보 (HeatWaveShelter2, 비우면 KMA_SERVICE_KEY 재사용)
SHELTER_SERVICE_KEY=
# 공공도서관 표준데이터 ODCloud (15136382, GG_DATA_KEY 미연동 시 폴백 · 비우면 KMA_SERVICE_KEY 재사용)
LIBRARY_SERVICE_KEY=
# 경기도 버스도착정보·버스위치·노선정보 (GBIS)
GBIS_SERVICE_KEY=
# 국토교통부 TAGO 버스위치정보 (비우면 GBIS_SERVICE_KEY 재사용)
TAGO_SERVICE_KEY=

# ── 지자체·관계기관 API ─────────────────────────────────────────
# 경기데이터드림 (https://data.gg.go.kr) — 버스정류소 · 공공도서관 · 문화행사 현황
GG_DATA_KEY=
# 재난안전데이터공유플랫폼 (https://www.safetydata.go.kr) — 한파·무더위·지진 쉼터 (DSSP-IF-10941)
SAFETY_DATA_KEY=
# 국가교통정보센터 (https://openapi.its.go.kr) — 돌발정보·소통정보·고속도로 CCTV
ITS_API_KEY=
# 나이스 교육정보 개방 포털 (https://open.neis.go.kr) — 학교 기본정보·학급·급식
NEIS_API_KEY=
# 네이버 개발자 센터 (https://developers.naver.com) — 지역 뉴스 · 시정/모집 소식 검색
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 데이터베이스 & 운영 ─────────────────────────────────────────
# Neon Postgres (교통 캐시, CCTV URL 캐시, 공장 지오코딩 캐시, 방문 통계)
DATABASE_URL=
# 비공개 접속 통계 페이지(/stats/<STATS_TOKEN>) 접근 토큰 (비우면 비활성)
STATS_TOKEN=
# (선택) 공개 사이트 기준 URL (예: https://uiwanginside.vercel.app)
PUBLIC_URL=
